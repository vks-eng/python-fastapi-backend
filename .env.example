# TaskForge API configuration. Copy to `.env` and fill in the secrets.
# NEVER commit `.env`. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# --- application -------------------------------------------------------------
# development | test | staging | production
ENVIRONMENT=development
# serve /docs, /redoc, /openapi.json
DOCS_ENABLED=true
# Requests with larger bodies are rejected with 413 (default 1 MiB)
MAX_REQUEST_BODY_BYTES=1048576
LOG_LEVEL=INFO
LOG_JSON=true

# --- database (PostgreSQL only) -----------------------------------------------
# Local (non-Docker) runs use DATABASE_URL directly.
DATABASE_URL=postgresql+asyncpg://taskforge:change-me@localhost:5432/taskforge
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_STATEMENT_TIMEOUT_MS=15000
DB_ECHO=false

# docker compose builds DATABASE_URL from these (and starts Postgres with them).
POSTGRES_USER=taskforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=taskforge
API_PORT=8000

# --- auth / JWT --------------------------------------------------------------
# REQUIRED. At least 32 characters of random data.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=taskforge-api
JWT_AUDIENCE=taskforge-api
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REQUIRE_ACCOUNT_ACTIVATION=false

# --- CORS (comma-separated list or JSON array; empty = CORS disabled) ----------
CORS_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=false

# --- rate limiting / redis -----------------------------------------------------
# Optional. Unset => in-process limiter. Compose sets it to the bundled Redis.
REDIS_URL=
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
REGISTER_RATE_LIMIT=10
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
REFRESH_RATE_LIMIT=30
REFRESH_RATE_LIMIT_WINDOW_SECONDS=60

# --- server (read by uvicorn inside the container) ------------------------------
WEB_CONCURRENCY=2
# Comma-separated proxy IPs trusted for X-Forwarded-For (client IP => rate limits).
FORWARDED_ALLOW_IPS=127.0.0.1
